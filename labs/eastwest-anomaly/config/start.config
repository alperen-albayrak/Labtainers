# Filename : start.config
# Lab      : eastwest-anomaly
#
# East-west (internal) traffic anomaly detection lab.
# An office LAN (user workstations + IT admin) and a three-tier server side
# (web / app / db) behind one router.  A hidden tap mirrors every internal LAN
# to a sensor that builds connection flows and raises anomaly alerts.

GLOBAL_SETTINGS
	GRADE_CONTAINER sensor
	HOST_HOME_XFER seed_dir/
	LAB_MASTER_SEED eastwest-anomaly_aa_master_seed

# ---------------------------------------------------------------------------
# Subnets.  All four internal LANs are tapped (TAP YES); their traffic is
# mirrored to the sensor on TAP_LAN.  Addresses use the 10.0.0.0/8 range to
# avoid clashing with other Docker networks on the build host.
# ---------------------------------------------------------------------------
NETWORK USER_LAN
	MASK 10.1.1.0/24
	GATEWAY 10.1.1.101
	TAP YES
NETWORK WEB_NET
	MASK 10.2.1.0/24
	GATEWAY 10.2.1.101
	TAP YES
NETWORK APP_NET
	MASK 10.2.2.0/24
	GATEWAY 10.2.2.101
	TAP YES
NETWORK DB_NET
	MASK 10.2.3.0/24
	GATEWAY 10.2.3.101
	TAP YES
NETWORK TAP_LAN
	MASK 10.9.9.0/24
	GATEWAY 10.9.9.101

# ---------------------------------------------------------------------------
# Containers
# ---------------------------------------------------------------------------

# Router: joins all four internal LANs, forwards between them and applies the
# fixed baseline segmentation (normal network policy, not the detection defense).
CONTAINER router
	USER ubuntu
	TERMINALS 0
	USER_LAN 10.1.1.9
	WEB_NET  10.2.1.9
	APP_NET  10.2.2.9
	DB_NET   10.2.3.9

# Office LAN -----------------------------------------------------------------
# ws1: compromised workstation (foothold for the user-to-user scenario).
CONTAINER ws1
	USER user
	USER_LAN 10.1.1.11
	LAB_GATEWAY 10.1.1.9
	ADD-HOST ws2:10.1.1.12
	ADD-HOST admin:10.1.1.13

# ws2: victim workstation, holds a secret file; runs sshd.
CONTAINER ws2
	USER user
	USER_LAN 10.1.1.12
	LAB_GATEWAY 10.1.1.9

# admin: IT admin workstation (helpdesk SSH to hosts, runs the checks).
CONTAINER admin
	USER admin
	USER_LAN 10.1.1.13
	LAB_GATEWAY 10.1.1.9
	ADD-HOST ws1:10.1.1.11
	ADD-HOST ws2:10.1.1.12
	ADD-HOST web:10.2.1.11
	ADD-HOST app:10.2.2.11
	ADD-HOST db:10.2.3.11

# Server side ----------------------------------------------------------------
# web: internet-facing web server, compromised (foothold for server scenario).
CONTAINER web
	USER www
	WEB_NET 10.2.1.11
	LAB_GATEWAY 10.2.1.9
	ADD-HOST app:10.2.2.11
	ADD-HOST db:10.2.3.11

# app: application server, exposes an HTTP API and sshd.
CONTAINER app
	USER app
	APP_NET 10.2.2.11
	LAB_GATEWAY 10.2.2.9
	ADD-HOST db:10.2.3.11

# db: database server with the secret table.
CONTAINER db
	USER db
	DB_NET 10.2.3.11
	LAB_GATEWAY 10.2.3.9

# Monitoring -----------------------------------------------------------------
# sensor: receives the mirrored traffic (becomes monitor_tap via TAP_LAN),
# builds flows and raises alerts.
CONTAINER sensor
	USER analyst
	TAP_LAN 10.9.9.3

# tap: hidden span port; mirrors all tapped LANs to the sensor.
CONTAINER tap
	USER ubuntu
	SCRIPT NONE
	TERMINALS 0
	TAP YES
